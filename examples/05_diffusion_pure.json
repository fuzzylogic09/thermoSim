    "visc": 1.5e-5, "diff": 2.1e-5, "beta": 3.4e-3,
    "gravity": 0, "T_amb": 50, "T_hot": 100, "T_cold": 0, "fan_speed": 2.0
  },
  "numerics": { "cfl": 0.5, "spf": 2, "iter": 20, "sim_speed": 1.0 },
  "geometry_objects": [
