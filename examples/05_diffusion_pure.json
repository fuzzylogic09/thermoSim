    { "id": 2, "name": "Mur droit",  "type": "wall", "shape": "vline", "x0": 0.98, "y0": 0, "x1": 1, "y1": 1, "radius": null, "visible": true, "props": {} }
  ],
  "probes": [
    { "id": 1, "label": "Bas",     "color": "#f0e040", "x": 0.5, "y": 0.1 },
    { "id": 2, "label": "Milieu",  "color": "#4ecdc4", "x": 0.5, "y": 0.5 },
    { "id": 3, "label": "Haut",    "color": "#ff6b6b", "x": 0.5, "y": 0.9 }
  ]
