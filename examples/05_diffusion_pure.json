{
  "version": 3,
  "meta": { "name": "Diffusion pure (loi de Fourier)", "date": "2025-01-01T00:00:00.000Z",
    "description": "Gravité nulle. Seule la diffusion thermique agit (loi de Fourier). Profil linéaire à l'équilibre entre fond chaud et plafond froid." },
  "domain": { "Lx": 1, "Ly": 1, "Nx": 64, "Ny": 64 },
